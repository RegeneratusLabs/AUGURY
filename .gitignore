# ---- model weights / adapters / quantized files (download or publish to HF Hub) ----
models/
minicpm5_v3_lora/
augury_minicpm5_v3_lora_merged_fp16/
*.gguf
*.safetensors
*.bin

# ---- vision image data (15GB; local-only build source — not published to HF) ----
data/vision/images/
data/vision/images_unknown/
data/vision/raw/
data/vision/output/

# ---- regenerable retrieval index + embedding cache ----
# index/  : rebuild via scripts/vision/build_index_v2.py
# emb/    : one .npy per image, rebuild via scripts/vision/cache_embeddings.py
#           (resumable; ~40 min on 16 CPU cores). Regenerable, so never committed.
data/vision/index/
data/vision/emb/

# index-v2/v3: the two large binaries stay local (regenerable, and no Git LFS on
# this host — committing them would add ~41MB per version to .git permanently).
# The small provenance files (keys.json, files.json, meta.json, band_config.json,
# README.md) ARE tracked, so the exact index composition stays auditable in git.
data/vision/index-v2/*.faiss
data/vision/index-v2/embeddings.npy
data/vision/index-v2/pca_whiten.npz
data/vision/index-v3/*.faiss
data/vision/index-v3/embeddings.npy
data/vision/index-v3/pca_whiten.npz

# ---- logs from interrupted acquisition/embedding runs (kept for diagnosis) ----
data/vision/logs-archive/

# ---- packaging artifacts ----
data/vision_cap15/
zipstage/
*.zip

# ---- training environments ----
.venv*/
venv/
__pycache__/
*.pyc
unsloth_compiled_cache/

# ---- vendored clones / third-party (pin versions in docs instead) ----
llama.cpp/
third_party/

# ---- agent session state (private) ----
.reasonix/
reasonix.toml

# ---- archived reference material ----
archive/

# ---- copyrighted source PDFs (do not redistribute; cite instead) ----
data/sources/*.pdf
# Scraped source pages kept for quote verification (scripts in data/research/_tools/).
# Regenerable and third-party copyrighted: cite the URL, do not redistribute.
data/research/_tools/cache/

# ---- misc ----
.DS_Store
*.log

# ---- superseded local backups (git history is the record now) ----
*.pre-cleanup
*.pre-mojibake

# ---- agent scratch dirs (transient) ----
.*_scratch/
.dsh-runtime/
# Gradle user home, redirected into the workspace because $HOME is read-only in
# this sandbox. Pure build cache (~500-600MB per copy), never source. Covers both
# the repo root and the Android project root: Gradle resolves a RELATIVE
# GRADLE_USER_HOME against the CWD it was invoked from, so both appeared.
.gradle-home/

# ---- regenerable scan output (48MB; rerun scan_image_quality.py) ----
data/vision/bench/image_quality.jsonl
# ---- quarantined galleries pending re-pull ----
data/vision/quarantine_fallback/

# ---- Android build artifacts ----
augury-android/.gradle/
augury-android/build/
augury-android/app/build/

# ---- Android native/CMake and gradle-home build state (embeds absolute paths) ----
augury-android/app/.cxx/
augury-android/.gradle-home/
.gradle-home/

# ---- Android local SDK path (machine-specific) ----
augury-android/local.properties
